# Copy to .env and fill in. Never commit .env.
# setup.ps1 writes this file for you with a generated JWT secret.
DATABASE_URL=postgresql+psycopg://gb_dev:YOUR_DB_PASSWORD@localhost:5432/greenbuffet_dev
JWT_SECRET=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-48
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
APP_TIMEZONE=Africa/Lusaka

# Email (stage 25). Set these with scripts\email-setup.ps1 rather than by hand.
# EMAIL_MODE is off, smtp, or file (development only: writes .eml files).
EMAIL_MODE=off
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=The Green Buffet
APP_URL=http://localhost:8000
